[
  {% for post in site.temas %}
    {
      "title": "{{ post.title | escape }}",
      "url": "{{ site.baseurl }}{{ post.url }}",
      "tags": "{{ post.tags | escape }}",
      "categories": "{{ post.categories | escape }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
